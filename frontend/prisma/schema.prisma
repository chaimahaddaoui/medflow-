datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Patient {
  id            Int      @id @default(autoincrement())
  nom           String
  prenom        String
  email         String
  dateNaissance DateTime
  telephone     String?
  adresse       String?

  appointments Appointment[]
  bills        Bill[]
}

model Appointment {
  id        Int      @id @default(autoincrement())
  date      DateTime
  heure     String
  statut    String
  patientId Int
  doctorId  Int

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])
  bills   Bill[]
}

model Bill {
  id            Int      @id @default(autoincrement())
  montant       Float
  statut        String
  dateCreation  DateTime @default(now())
  patientId     Int
  appointmentId Int?

  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
}


model Clinic {
  id          Int          @id @default(autoincrement())
  nom         String
  adresse     String
  telephone   String
  email       String
  logo        String? // (URL ou path vers une image, optionnel)
  horaires    String? // (ex: "Lun-Ven 8h-20h", optionnel)
  specialites Speciality[] // RELATION 
  createdAt   DateTime     @default(now())
  doctors     Doctor[]
}


model Speciality {
  id       Int      @id @default(autoincrement())
  label    String
  clinicId Int
  clinic   Clinic   @relation(fields: [clinicId], references: [id])
  doctors  Doctor[] // OK car relation symétrique ci-dessous
}
model Doctor {
  id           Int           @id @default(autoincrement())
  nom          String
  prenom       String
  specialiteId Int?          
  specialite   Speciality?   @relation(fields: [specialiteId], references: [id])
  email        String
  telephone    String?
  appointments Appointment[]
  clinicId     Int?          
  clinic       Clinic?       @relation(fields: [clinicId], references: [id])
}

