generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id            Int            @id @default(autoincrement())
  nom           String
  prenom        String
  email         String         @unique
  dateNaissance DateTime
  telephone     String?
  adresse       String?
  password      String?
  clinicId      Int?
  appointments  Appointment[]
  bills         Bill[]
  clinic        Clinic?        @relation(fields: [clinicId], references: [id])
  prescriptions Prescription[]
}

model Appointment {
  id            Int            @id @default(autoincrement())
  date          DateTime
  heure         String
  statut        String
  patientId     Int
  doctorId      Int
  doctor        Doctor         @relation(fields: [doctorId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  bill          Bill?
  prescriptions Prescription[]
}


model Bill {
  id            Int      @id @default(autoincrement())
  montant       Float
  statut        String
  dateCreation  DateTime @default(now())
  datePaiement  DateTime?
  modePaiement  String?
  patientId     Int
  appointmentId Int?     @unique   // <-- AJOUT @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  patient       Patient      @relation(fields: [patientId], references: [id])
}
model Clinic {
  id           Int            @id @default(autoincrement())
  nom          String
  adresse      String
  telephone    String
  email        String
  logo         String?
  horaires     String?
  createdAt    DateTime       @default(now())
  doctors      Doctor[]
  patients     Patient[]
  receptionist Receptionist[]
  specialites  Speciality[]
}

model Speciality {
  id          Int      @id @default(autoincrement())
  label       String
  clinicId    Int
  description String?
  doctors     Doctor[]
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
}

model Doctor {
  id             Int                  @id @default(autoincrement())
  nom            String
  prenom         String
  email          String               @unique
  telephone      String?
  clinicId       Int?
  specialiteId   Int?
  password       String               @default("changeme123")
  appointments   Appointment[]
  clinic         Clinic?              @relation(fields: [clinicId], references: [id])
  specialite     Speciality?          @relation(fields: [specialiteId], references: [id])
  availabilities DoctorAvailability[]
  prescriptions  Prescription[]
}

model SpecialityCentral {
  id          Int     @id @default(autoincrement())
  label       String
  description String?
}

model Receptionist {
  id        Int      @id @default(autoincrement())
  nom       String
  prenom    String
  email     String   @unique
  password  String
  telephone String?
  clinicId  Int
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
}

model Prescription {
  id            Int          @id @default(autoincrement())
  createdAt     DateTime     @default(now())
  doctorId      Int
  patientId     Int
  appointmentId Int?
  medicaments   String
  notes         String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  doctor        Doctor       @relation(fields: [doctorId], references: [id])
  patient       Patient      @relation(fields: [patientId], references: [id])
}

model DoctorAvailability {
  id        Int      @id @default(autoincrement())
  doctorId  Int
  start     DateTime
  end       DateTime
  type      String?
  note      String?
  createdAt DateTime @default(now())
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
}

model Admin {
  id        Int      @id @default(autoincrement())
  nom       String
  prenom    String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}
