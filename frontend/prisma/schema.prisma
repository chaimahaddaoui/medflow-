datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Patient {
  id            Int            @id @default(autoincrement())
  nom           String
  prenom        String
  email         String         @unique
  password      String?
  dateNaissance DateTime
  telephone     String?
  adresse       String?
  appointments  Appointment[]
  bills         Bill[]
  clinicId      Int?
  clinic        Clinic?        @relation(fields: [clinicId], references: [id])
  prescriptions Prescription[]
}

model Appointment {
  id        Int      @id @default(autoincrement())
  date      DateTime
  heure     String
  statut    String
  patientId Int
  doctorId  Int

  patient       Patient        @relation(fields: [patientId], references: [id])
  doctor        Doctor         @relation(fields: [doctorId], references: [id])
  bills         Bill[]
  prescriptions Prescription[]
}

model Bill {
  id            Int      @id @default(autoincrement())
  montant       Float
  statut        String
  dateCreation  DateTime @default(now())
  patientId     Int
  appointmentId Int?

  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
}

model Clinic {
  id           Int            @id @default(autoincrement())
  nom          String
  adresse      String
  telephone    String
  email        String
  logo         String?
  horaires     String?
  specialites  Speciality[]
  createdAt    DateTime       @default(now())
  doctors      Doctor[]
  receptionist Receptionist[]
  patients     Patient[]
}

model Speciality {
  id          Int      @id @default(autoincrement())
  label       String
  description String?
  clinicId    Int
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  doctors     Doctor[]
}

model Doctor {
  id            Int            @id @default(autoincrement())
  nom           String
  prenom        String
  specialiteId  Int?
  specialite    Speciality?    @relation(fields: [specialiteId], references: [id])
  email         String         @unique
  password      String         @default("changeme123")
  telephone     String?
  appointments  Appointment[]
  clinicId      Int?
  clinic        Clinic?        @relation(fields: [clinicId], references: [id])
  prescriptions Prescription[]
  availabilities DoctorAvailability[]
}

model SpecialityCentral {
  id          Int     @id @default(autoincrement())
  label       String
  description String?
}

model Receptionist {
  id        Int      @id @default(autoincrement())
  nom       String
  prenom    String
  email     String   @unique
  password  String
  telephone String?
  clinicId  Int
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  createdAt DateTime @default(now())
}

model Prescription {
  id            Int          @id @default(autoincrement())
  createdAt     DateTime     @default(now())
  doctor        Doctor       @relation(fields: [doctorId], references: [id])
  doctorId      Int
  patient       Patient      @relation(fields: [patientId], references: [id])
  patientId     Int
  // optionnel : lier directement à un rendez-vous
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  appointmentId Int?

  // Contenu de l’ordonnance
  medicaments String // ex: JSON ou texte libre (liste des médicaments)
  notes       String? // recommandations supplémentaires
}


model DoctorAvailability {
  id        Int      @id @default(autoincrement())
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  doctorId  Int

  start     DateTime
  end       DateTime

  type      String?  // ex: "Consultation", "Contrôle", etc.
  note      String?

  createdAt DateTime @default(now())
}
model Admin {
  id       Int    @id @default(autoincrement())
  nom      String
  prenom   String
  email    String @unique
  password String
  createdAt DateTime @default(now())
}